# Frontend Environment Variables
# For development: VITE_API_BASE_URL=http://localhost:5000/api/v1
# For production: VITE_API_BASE_URL=https://your-backend-url.vercel.app/api/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME="SHOROBOR | Bangladeshi Heritage E-Commerce"
VITE_ENABLE_MOCK_FALLBACK=true
VITE_DEFAULT_CURRENCY=BDT
