{
  "name": "bangladeshi-e-commerce-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack High-Performance Bangladeshi E-Commerce Platform with Storefront, Admin Suite, and Payment Gateways (bKash, Nagad, SSLCommerz, COD) using MongoDB",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "lint": "cd frontend && npm run lint",
    "seed:db": "npx tsx database/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.0",
    "morgan": "^1.12.1"
  }
}
